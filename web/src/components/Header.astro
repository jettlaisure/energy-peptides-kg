---
import Lockup from './Lockup.astro';
import { site, money, cents } from '../lib/catalog';
const path = Astro.url.pathname;
const nav = [
  { href: '/products/', label: 'Catalog' },
  { href: '/faq/', label: 'FAQ & testing' },
  { href: '/legal/research-use-only/', label: 'Research use policy' },
];
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="announcement"><div class="container announcement-inner"><p>{site.compliance_line}</p><a href="/legal/shipping-returns/">Free US shipping on orders {money(cents(site.free_shipping_over_usd))}+ <span aria-hidden="true">↗</span></a></div></div>
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Energy Peptides home"><Lockup height={38} /></a>
    <nav class="desktop-nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="cart-link" href="/cart/" aria-label="Cart">
      <span class="cart-label">Cart</span>
      <span class="cart-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span class="count num" data-cart-count hidden>0</span>
      </span>
    </a>
    <details class="mobile-menu">
      <summary aria-label="Toggle navigation"><span>Menu</span><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><path d="M2 6h16M2 14h16"/></svg></summary>
      <nav aria-label="Mobile navigation">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}<span aria-hidden="true">↗</span></a>)}
      </nav>
    </details>
  </div>
</header>
<script>
  import { cartCount } from '../lib/cart';
  const el = document.querySelector<HTMLElement>('[data-cart-count]');
  const paint = (n: number) => { if (!el) return; el.textContent = String(n); el.hidden = n === 0; };
  paint(cartCount());
  document.addEventListener('cart:change', (e) => paint((e as CustomEvent).detail.count));
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
  });
</script>
<style>
  .announcement { background: var(--navy); border-bottom: var(--hairline); font-size: 11px; color: var(--text-dim); }
  .announcement-inner { display: flex; justify-content: space-between; gap: 16px; padding-block: 9px; }
  .announcement p { letter-spacing: .035em; }
  .announcement a { color: var(--text-dim); }
  .announcement a span { margin-left: 8px; color: var(--gold-hi); }
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--void); border-bottom: var(--hairline); }
  .bar { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 24px; height: 78px; }
  .brand { text-decoration: none; display: inline-flex; flex-shrink: 0; justify-self: start; }
  .desktop-nav { display: flex; justify-content: center; gap: var(--s6); white-space: nowrap; }
  nav a { color: var(--text-dim); font-size: 14px; font-weight: 500; padding: 12px 0; border-bottom: 1px solid transparent; text-decoration: none; }
  nav a:hover, nav a[aria-current="page"] { color: var(--text); border-bottom-color: var(--gold); }
  .cart-link { display: inline-flex; align-items: center; gap: 6px; justify-self: end; height: 44px; flex-shrink: 0; color: var(--text); font-size: 14px; text-decoration: none; }
  .cart-icon { position: relative; display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; transform: scale(calc(20 / 28)); }
  .count { position: absolute; top: 0; right: 0; display: inline-grid; place-items: center; min-width: 18px; aspect-ratio: 1; padding: 2px; font-size: 9px; line-height: 1; background: var(--void); color: var(--gold); border: 1px solid var(--gold); border-radius: 50%; box-shadow: 0 0 0 2px var(--void); font-weight: 700; }
  .mobile-menu { display: none; }
  @media (max-width: 960px) {
    .bar { display: flex; height: 76px; gap: 20px; }
    .desktop-nav { display: none; }
    .cart-link { margin-left: auto; min-width: 44px; justify-content: center; }
    .cart-label, summary > span { display: none; }
    .mobile-menu { display: block; }
    summary { display: flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; cursor: pointer; list-style: none; font-size: 14px; }
    summary::-webkit-details-marker { display: none; }
    .mobile-menu nav { position: absolute; top: 100%; left: 0; right: 0; background: var(--void); border-bottom: var(--hairline); padding: 16px var(--gutter) 24px; display: grid; }
    .mobile-menu nav a { display: flex; justify-content: space-between; padding: 16px 0; }
    .announcement-inner { justify-content: center; text-align: center; }
    .announcement p { display: none; }
  }
  @media (max-width: 380px) { .bar { gap: 12px; } summary span { display: none; } }
</style>

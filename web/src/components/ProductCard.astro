---
import { money, cents, sizeLabel, familyName, compositionLine, type Product } from '../lib/catalog';
import VialArt from './VialArt.astro';
interface Props { product: Product }
const { product: p } = Astro.props;
const stock = p.status === 'coming_soon' ? { cls: 'chip-off', text: 'Coming soon' } : p.in_stock ? { cls: 'chip-on', text: 'In stock' } : { cls: 'chip-off', text: 'Out of stock' };
---
<article class="pc">
  <a class="media" href={`/products/${p.slug}/`} tabindex="-1" aria-hidden="true">
    {p.images?.square
      ? <img src={p.images.square} alt="" width="1600" height="1600" loading="lazy" decoding="async" />
      : <VialArt product={p} />}
  </a>
  <div class="body">
    <p class="eyebrow">{p.composition_class}</p>
    <h3 class="t-card"><a href={`/products/${p.slug}/`}><span class="name">{familyName(p)}</span> <span class="dim amt">{sizeLabel(p)}</span></a></h3>
    {compositionLine(p) && <p class="comp t-small value">{compositionLine(p)}</p>}
    <div class="row">
      <span class="value price">{money(cents(p.price_usd))}</span>
      <span class:list={['chip', stock.cls]}>{stock.text}</span>
    </div>
  </div>
</article>
<style>
  .pc { display: flex; flex-direction: column; background: var(--navy); border: var(--hairline); border-radius: var(--radius); overflow: hidden; transition: background-color .15s, border-color .15s; }
  .pc:hover { background: var(--navy-lift); border-color: var(--steel); }
  .media { display: block; background: #EFEEEA; }
  .media img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; border-bottom: var(--hairline); }
  .media :global(.vial) { border: 0; border-radius: 0; border-bottom: var(--hairline); }
  .body { padding: var(--s4); display: flex; flex-direction: column; gap: var(--s2); }
  h3 a { color: var(--text); }
  h3 a:hover { text-decoration: none; color: var(--gold-hi); }
  .amt { font-weight: 400; }
  .comp { font-size: 12px; line-height: 1.4; }
  .row { display: flex; align-items: center; justify-content: space-between; padding-top: var(--s1); }
  .price { font-size: 17px; font-weight: 700; }
</style>

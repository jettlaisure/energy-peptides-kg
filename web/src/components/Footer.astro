---
import Lockup from './Lockup.astro';
import { site } from '../lib/catalog';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div class="stack">
      <a class="footer-brand" href="/" aria-label="Energy Peptides home"><Lockup height={38} /></a>
      <p class="dim t-small">Research peptides and laboratory compounds, tested batch by batch to a ≥99% purity specification. Ships within the {site.ships_to.replace(' only', '')}.</p>
    </div>
    <div>
      <p class="eyebrow">Catalog</p>
      <ul>
        <li><a href="/products/">Browse by composition</a></li>
        <li><a href="/products/#supplies">Laboratory supplies</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">Company</p>
      <ul>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/legal/research-use-only/">Research use policy</a></li>
        <li><a href="/legal/shipping-returns/">Shipping and returns</a></li>
        <li><a href="/legal/terms/">Terms of sale</a></li>
        <li><a href="/legal/privacy/">Privacy</a></li>
        <li><a href="/faq/#FAQ-3">Testing & certificates</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p class="compliance">{site.compliance_line}</p>
    <p class="faint t-small">Products have not been evaluated or approved by the FDA. Purchasers attest that they are 21 or older and buying for laboratory research. © {year} {site.seller}. {site.brand} is a brand of {site.seller}.</p>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--section); background: var(--void); border-top: var(--hairline); padding-block: var(--s8) var(--s6); }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: var(--s8); }
  .footer-brand { display: inline-flex; width: fit-content; margin-bottom: 8px; }
  .stack > p { max-width: 38ch; }
  ul a { display: inline-block; padding-block: 4px; }
  ul { list-style: none; margin: var(--s3) 0 0; padding: 0; display: grid; gap: var(--s2); }
  ul a { color: var(--text-dim); font-size: 14px; }
  ul a:hover { color: var(--text); }
  .legal { border-top: var(--hairline); margin-top: var(--s7); padding-top: var(--s5); display: grid; gap: var(--s3); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr 1fr; gap: 32px 24px; } .grid > .stack { grid-column: 1 / -1; } }
</style>

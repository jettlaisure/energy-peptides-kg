---
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import FaqList from '../components/FaqList.astro';
import MembershipTiers from '../components/MembershipTiers.astro';
import { products, catalog, site } from '../lib/catalog';
// Show available compounds first without changing the graph's stock or catalog data.
const compounds = products.filter((p) => p.category !== 'accessory')
  .sort((a, b) => Number(b.in_stock && b.status === 'active') - Number(a.in_stock && a.status === 'active'));
const faqPreview = catalog.faq.filter((f) => ['FAQ-3', 'FAQ-2', 'FAQ-6'].includes(f.id));
---
<Base title={`${site.brand} — research peptides, independently tested lots`}>
  <div class="landing">
    <section class="hero-wrap">
      <div class="hero container">
        <div class="hero-copy">
          <p class="eyebrow">Energy Peptides / The collection</p>
          <h1>Precision.<br />In every <span>detail.</span></h1>
          <p class="t-lede">Research peptides. Clearly specified.<br />Discover the collection—and membership that grows with you.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/products/">Shop the collection <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#membership">Explore membership <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">For Research Use Only — Not for Human Consumption</p>
        </div>
        <figure class="hero-product">
          <img src="/img/brand/membership-natural-1200.webp" srcset="/img/brand/membership-natural-600.webp 600w, /img/brand/membership-natural-900.webp 900w, /img/brand/membership-natural-1200.webp 1200w, /img/brand/membership-natural-1536.webp 1536w" width="1536" height="1024" alt="Energy Peptides BPC-157 vials with Navy, Graphite and Black membership labels" sizes="(max-width: 767px) 100vw, 58vw" loading="eager" fetchpriority="high" />
          <figcaption><span>Navy · Graphite · Black</span><a href="/membership/">Three levels. One standard. <span aria-hidden="true">↗</span></a></figcaption>
        </figure>
      </div>
      <div class="trust-strip container" aria-label="Testing and documentation">
        <div><strong>≥99%</strong><p>Purity specification<span>On independently tested lots</span></p></div>
        <div><strong>HPLC + MS</strong><p>Purity & identity<span>Independent laboratory</span></p></div>
        <div><strong>COA</strong><p>Certificates on request<span>For every tested lot</span></p></div>
      </div>
    </section>

    <div class="light-surface">
    <section class="section container collection" id="catalog">
      <div class="section-head"><div class="stack"><p class="eyebrow">The collection</p><h2 class="t-section">The research catalog</h2><p>Prices per vial. Every compound, clearly specified.</p></div><a class="text-link" href="/products/">Browse all {products.length} products <span aria-hidden="true">↗</span></a></div>
      <div class="catalog-rail" tabindex="0" role="region" aria-label="Research products, scroll horizontally to browse"><ProductGrid products={compounds} /></div>
      <div class="rail-footer"><p>Explore the collection by composition and amount.</p><div class="rail-controls" hidden><button type="button" data-rail-prev aria-label="Previous products" aria-controls="catalog">←</button><button type="button" data-rail-next aria-label="Next products" aria-controls="catalog">→</button></div></div>
    </section>

    </div>

    <section class="membership-wrap" id="membership" aria-labelledby="membership-title">
      <div class="container section membership-section">
        <div class="section-head">
          <div class="stack"><p class="eyebrow">Energy Peptides membership</p><h2 class="t-section" id="membership-title">Your loyalty. Recognized.</h2><p>Three levels, earned through your orders. No sign-up. No annual fee.</p></div>
          <a class="text-link" href="/membership/">How membership works <span aria-hidden="true">↗</span></a>
        </div>
        <MembershipTiers />
        <div class="membership-foot"><p>Your label reflects your status. The compound, lot and documentation stay the same at every level.</p><a class="text-link" href="/products/">Find your next compound <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <div class="light-surface">
    <section class="section container composition">
      <h2 class="t-section">Know your compound.</h2>
      <div class="composition-intro"><p class="dim">Browse by composition, with amounts and specifications on every product.</p><a class="text-link" href="/products/">Browse by composition <span aria-hidden="true">↗</span></a></div>
    </section>

    </div>

    <section class="quality-wrap" id="quality">
      <div class="section container quality">
        <header class="quality-intro"><p class="eyebrow">Our standards</p><h2 class="t-section">The details matter.<br /><span class="dim">Down to the lot.</span></h2><p class="dim">{site.testing_line}</p><a class="text-link" href="/faq/#FAQ-3">Understand our testing <span aria-hidden="true">↗</span></a></header>
        <div class="quality-content">
          <div class="purity"><span class="purity-number">≥99<span>%</span></span><div><h3>Purity specification</h3><p>Tested lots are analysed by an independent laboratory. Certificates of analysis available on request.</p></div></div>
          <div class="quality-notes"><div><h3>Sealed & carefully stored</h3><p>Lyophilized powder in sealed vials, stored at −20 °C before dispatch.</p><a href="/faq/">Handling and storage guidance ↗</a></div><div><h3>Exclusively for research</h3><p>Every product is sold for laboratory research. Purchasers attest to this at checkout.</p><a href="/legal/research-use-only/">Read the policy ↗</a></div></div>
        </div>
      </div>
    </section>

    <div class="light-surface">
    <section class="section container questions">
      <header class="questions-intro"><h2 class="t-section">Good questions.<br /><span class="dim">Clear answers.</span></h2><p class="dim">Testing, handling, and research-use requirements, in one place.</p><a class="text-link" href="/faq/">Visit the FAQ <span aria-hidden="true">↗</span></a></header>
      <FaqList items={faqPreview} />
    </section>
    </div>
  </div>
</Base>
<script>
  const rail = document.querySelector<HTMLElement>('.catalog-rail');
  const controls = document.querySelector<HTMLElement>('.rail-controls');
  const previous = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
  if (rail && controls && previous && next) {
    controls.hidden = false;
    const update = () => {
      previous.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
    };
    const move = (direction: number) => rail.scrollBy({ left: direction * rail.clientWidth * .85, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    rail.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(rail);
    update();
  }
</script>
<style>
  @font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 900; font-display: swap; src: url('/fonts/playfair-display-900.woff2') format('woff2'); }
  /* Brand-led redesign: variance 6 / motion 3 / density 3.
     Preserve the mandated dark-ground identity; native Astro + CSS, no runtime UI library. */
  .landing { background: var(--void); }
  .light-surface {
    color-scheme: light;
    --text: #11162A;
    --text-dim: #4d5869;
    --text-faint: #5d6776;
    --steel: #5d6776;
    --powder: #11162A;
    --gold: #8a6410;
    --gold-hi: #8a6410;
    --seedpearl: #11162A;
    --rule: #d8d8d2;
    --hairline: 1px solid var(--rule);
    background: var(--paper);
    color: var(--text);
  }
  .light-surface:has(.composition) { background: var(--seedpearl-hover); }
  .light-surface :global(:focus-visible) { outline-color: var(--gold-ink); }
  .light-surface .catalog-rail { scrollbar-color: var(--rule) var(--paper); }
  .light-surface .rail-controls button:hover { background: #e9e7de; }
  .landing .section { padding-block: 100px; }
  .landing .t-section { font-size: clamp(32px, 3.2vw, 46px); font-weight: 500; line-height: 1.14; letter-spacing: -.045em; }
  .hero { display: grid; grid-template-columns: 1.12fr 1fr; align-items: center; gap: 68px; padding-block: 44px 52px; }
  .hero-copy { display: grid; gap: 30px; }
  .hero-copy .eyebrow { color: var(--gold); }
  .hero h1 { font-family: var(--sans); font-size: clamp(44px, 5.8vw, 80px); font-weight: 900; line-height: 1.08; letter-spacing: -.035em; text-wrap: initial; }
  .hero h1 > span { color: var(--gold); }
  .hero .t-lede { font-size: 17px; font-weight: 400; line-height: 1.8; max-width: 44ch; }
  .hero-actions { display: flex; flex-direction: column; align-items: start; gap: 20px; }
  .hero-actions .btn { padding: 20px 25px; min-height: 58px; gap: 42px; background: transparent; border-color: var(--gold); color: var(--gold); border-radius: 2px; white-space: nowrap; transition: border-color .2s, color .2s, transform .2s; }
  .hero-actions .btn:hover { background: transparent; border-color: var(--seedpearl); color: var(--seedpearl); transform: translateY(-2px); box-shadow: none; }
  .hero-actions .btn:active { transform: translateY(0); }
  .text-link { display: inline-flex; align-items: center; gap: 20px; color: var(--text); font-size: 13px; font-weight: 500; min-height: 44px; text-underline-offset: 6px; }
  .text-link > span { color: var(--gold); font-size: 18px; transition: transform .2s; }
  .text-link:hover > span { transform: translate(2px, -2px); }
  .hero-product { margin: 0; min-width: 0; }
  figcaption a { display: flex; align-items: center; justify-content: space-between; padding-block: 18px 0; color: var(--text); font-size: 13px; }
  figcaption a > span:last-child { color: var(--seedpearl); }
  figcaption a > span:last-child span { margin-left: 18px; }
  .trust-strip { display: grid; grid-template-columns: 1fr 1.15fr 1fr; border-top: var(--hairline); border-bottom: var(--hairline); padding-block: 30px; gap: 32px; }
  .trust-strip > div { display: flex; gap: 22px; align-items: center; }
  .trust-strip > div + div { border-left: var(--hairline); padding-left: 32px; }
  .trust-strip strong { font-size: 25px; font-weight: 500; letter-spacing: -.04em; white-space: nowrap; }
  .trust-strip p { font-size: 12px; }
  .trust-strip p span { display: block; color: var(--text-dim); font-size: 11px; margin-top: 4px; }
  .composition { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .landing .composition { padding-block: 48px 64px; }
  .composition-intro { display: grid; gap: 16px; justify-items: start; }
  .composition-intro p { max-width: 42ch; font-size: 15px; }
  .collection .section-head { margin-bottom: 40px; }
  .collection .eyebrow, .quality .eyebrow { color: var(--gold); }
  .catalog-rail { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 1px; scrollbar-color: var(--rule) var(--void); scrollbar-width: thin; padding: 2px 2px 24px; }
  .catalog-rail :global(.grid) { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 3.4); gap: 24px; }
  .catalog-rail :global(.pc) { scroll-snap-align: start; }
  .rail-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 20px; }
  .rail-footer p { color: var(--text-dim); font-size: 12px; }
  .rail-controls { display: flex; gap: 10px; }
  .rail-controls button { width: 48px; height: 48px; border: var(--hairline); border-radius: 2px; background: transparent; color: var(--seedpearl); font-size: 20px; cursor: pointer; }
  .rail-controls button:hover { background: var(--navy); }
  .rail-controls button:disabled { opacity: .35; cursor: default; }
  .quality-wrap { background: var(--navy); border-block: var(--hairline); }
  .quality { display: grid; grid-template-columns: .8fr 1.3fr; gap: 100px; align-items: start; }
  .quality-intro { display: grid; gap: 24px; }
  .quality-intro > p.dim { font-size: 14px; max-width: 36ch; }
  .purity { padding-bottom: 42px; border-bottom: var(--hairline); }
  .purity-number { display: block; font-size: clamp(76px, 8vw, 116px); line-height: 1; letter-spacing: -.07em; color: var(--seedpearl); font-weight: 300; margin-bottom: 25px; }
  .purity-number > span { font-size: .6em; }
  .quality h3 { font-size: 16px; font-weight: 500; margin-bottom: 10px; }
  .quality-content p { color: var(--text-dim); font-size: 13px; max-width: 48ch; }
  .quality-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; margin-top: 32px; }
  .quality-notes a { display: inline-block; padding-top: 18px; font-size: 12px; color: var(--text); }
  .questions { display: grid; grid-template-columns: .8fr 1.3fr; gap: 100px; }
  .questions-intro { display: grid; gap: 24px; align-content: start; }
  .questions-intro p { font-size: 14px; max-width: 30ch; }
  @media (max-width: 1100px) { .hero { gap: 36px; } .trust-strip { gap: 20px; } .trust-strip > div { gap: 14px; } .trust-strip > div + div { padding-left: 20px; } .trust-strip strong { font-size: 22px; } .composition, .quality, .questions { gap: 48px; } }
  @media (max-width: 767px) {
    .landing .section { padding-block: 64px; }
    .hero { grid-template-columns: 1fr; padding-block: 48px 32px; gap: 40px; }
    .hero-copy { gap: 24px; }
    .hero h1 { font-size: clamp(42px, 9.8vw, 70px); }
    .hero .t-lede { font-size: 15px; }
    .hero-actions { flex-direction: row; align-items: center; flex-wrap: wrap; gap: 12px 24px; }
    .hero-actions .btn { min-height: 54px; }
    .hero-product { width: 100%; }
    .trust-strip { grid-template-columns: 1fr; gap: 22px; padding-block: 28px; }
    .trust-strip > div + div { border: 0; padding: 0; }
    .trust-strip strong { width: 115px; flex-shrink: 0; }
    .trust-strip p span { margin-top: 2px; }
    .composition, .quality, .questions { grid-template-columns: 1fr; gap: 36px; }
    .landing .composition { padding-block: 36px 48px; gap: 20px; }
    .catalog-rail :global(.grid) { grid-auto-columns: 78%; gap: 16px; }
    .quality-notes { gap: 24px; }
    .rail-footer p { max-width: 23ch; }
  }
  @media (max-width: 380px) { .quality-notes { grid-template-columns: 1fr; } .desktop-break { display: none; } .catalog-rail :global(.grid) { grid-auto-columns: 94%; } }
</style>

<style>
  .hero-wrap { background: var(--navy); }
  .hero { grid-template-columns: .85fr 1.15fr; gap: 48px; padding-block: 72px 56px; }
  .hero-copy { gap: 24px; }
  .hero h1 { font-size: clamp(48px, 5.4vw, 78px); line-height: 1.02; letter-spacing: -.065em; font-weight: 500; }
  .hero h1 > span { color: var(--seedpearl); }
  .hero .t-lede { font-size: 16px; line-height: 1.75; }
  .hero-actions { gap: 8px; }
  .hero-actions .btn { background: var(--seedpearl); color: var(--void); border-color: var(--seedpearl); font-weight: 700; }
  .hero-actions .btn:hover { background: var(--seedpearl-hover); color: var(--void); }
  .hero-note { color: var(--text-dim); font-size: 10px; letter-spacing: .025em; }
  .hero-product img { width: 100%; height: auto; }
  .hero-product figcaption { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 16px; font-size: 11px; color: var(--text-dim); }
  .hero-product figcaption a { padding: 0; font-size: 11px; gap: 12px; }
  .trust-strip { padding-block: 24px; }
  .trust-strip strong { color: var(--seedpearl); font-size: 22px; }
  .membership-wrap { background: var(--void); }
  .membership-section .eyebrow { color: var(--gold); }
  .membership-section .section-head { margin-bottom: 32px; }
  .membership-foot { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-top: 24px; }
  .membership-foot p { color: var(--text-dim); max-width: 62ch; font-size: 12px; }
  .membership-foot a { flex-shrink: 0; }
  @media (max-width: 1000px) { .hero { gap: 28px; } .hero h1 { font-size: 58px; } }
  @media (max-width: 767px) {
    .hero { grid-template-columns: 1fr; padding-block: 40px 32px; gap: 28px; }
    .hero h1 { font-size: clamp(48px, 12vw, 70px); }
    .hero-copy { gap: 20px; }
    .hero-actions { flex-direction: row; gap: 12px 20px; }
    .hero-actions .btn { padding: 18px; gap: 18px; }
    .hero-product figcaption { font-size: 10px; }
    .hero-product figcaption a { font-size: 10px; }
    .membership-section .section-head, .membership-foot { align-items: start; flex-direction: column; gap: 20px; }
  }
</style>

<style>
  @media (max-width: 767px) {
    .hero { gap: 20px; padding-top: 32px; }
    .hero-copy { display: contents; }
    .hero-copy > .eyebrow { order: 0; }
    .hero-copy > h1 { order: 1; }
    .hero-product { order: 2; }
    .hero-product img { display: block; width: 100%; margin-inline: auto; transform: none; }
    .hero-copy > .t-lede { order: 3; }
    .hero-copy > .hero-actions { order: 4; }
    .hero-copy > .hero-note { order: 5; }
    .hero-product figcaption { padding-top: 8px; }
    .hero-actions { flex-direction: column; align-items: stretch; gap: 8px; }
    .hero-actions .btn { width: 100%; justify-content: space-between; }
    .hero-actions .text-link { justify-content: center; }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import CatalogFilters from '../../components/CatalogFilters.astro';
import { products, site, compositionClasses } from '../../lib/catalog';
const supplies = products.filter((p) => p.category === 'accessory');
const groups = compositionClasses.filter((c) => c.products.some((p) => p.category !== 'accessory'));
---
<Base title="Catalog" description={`All ${site.brand} research peptides and laboratory supplies, grouped by composition, tested to a ≥99% purity specification. ${site.compliance_line}.`}>
  <div class="catalog-shell">
  <section class="section container">
    <div class="section-head">
      <div><p class="eyebrow">Catalog</p><h1 class="t-section">Browse by composition</h1></div>
      <p>{products.length} products. Prices per vial; every batch tested to a ≥99% purity specification.</p>
    </div>
    <div class="catalog-discovery">
      <CatalogFilters />
      <details class="composition-directory">
        <summary><span>Composition shortcuts</span><span class="directory-hint">Jump to a category</span><span class="directory-toggle" aria-hidden="true">+</span></summary>
        <nav class="jump" aria-label="Composition classes">
          {groups.map((c) => <a href={`#${c.slug}`}><span>{c.name}</span><span aria-hidden="true">↗</span></a>)}
          {supplies.length > 0 && <a href="#supplies"><span>Laboratory supplies</span><span aria-hidden="true">↗</span></a>}
        </nav>
      </details>
    </div>
  </section>
  {groups.map((c) => (
    <section class="section container" id={c.slug} data-catalog-group>
      <div class="section-head group-heading"><h2 class="t-sub">{c.name}</h2><p class="group-count">{c.products.filter((p) => p.category !== 'accessory').length} {c.products.filter((p) => p.category !== 'accessory').length === 1 ? 'product' : 'products'}</p></div>
      <ProductGrid products={c.products.filter((p) => p.category !== 'accessory')} />
    </section>
  ))}
  {supplies.length > 0 && (
    <section class="section container" id="supplies" data-catalog-group>
      <div class="section-head"><h2 class="t-sub">Laboratory supplies</h2><p>Solvents and consumables for handling and storage in the laboratory.</p></div>
      <ProductGrid products={supplies} />
    </section>
  )}
  </div>
</Base>
<style>
  .section-head h1 { margin-top: 16px; }
  .catalog-shell { background: var(--navy); --navy-lift: var(--navy); --powder: var(--text); }
  .section-head h1 { font-size: clamp(36px, 4.6vw, 60px); font-weight: 500; letter-spacing: -.04em; }
  .section-head h2 { font-weight: 500; }
  .catalog-shell :global(.product-cta span) { color: var(--text-dim); }
  .catalog-shell :global(.pc:hover .product-cta span) { color: var(--gold-hi); }
  .catalog-discovery { background: var(--void); border: var(--hairline); padding-inline: clamp(20px, 3vw, 32px); }
  .catalog-shell :global(.catalog-tools) { background: transparent; border: 0; border-radius: 0; padding: 24px 0; margin-top: 0; }
  .composition-directory { border-top: var(--hairline); }
  .composition-directory summary { display: flex; align-items: center; gap: 24px; min-height: 64px; padding-block: 16px; cursor: pointer; list-style: none; font-size: 14px; font-weight: 500; }
  .composition-directory summary::-webkit-details-marker { display: none; }
  .directory-hint { font-size: 12px; font-weight: 400; color: var(--text-dim); margin-left: auto; }
  .directory-toggle { font-size: 22px; color: var(--gold); font-weight: 400; transition: transform .2s; }
  .composition-directory[open] .directory-toggle { transform: rotate(45deg); }
  .jump { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; padding-bottom: 24px; }
  .jump a { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-block: 16px; border-top: var(--hairline); color: var(--text-dim); font-size: 13px; line-height: 1.5; transition: color .2s; }
  .jump a > span:last-child { color: var(--gold); }
  .jump a:hover { color: var(--text); text-decoration: none; }
  @media (max-width: 640px) { .jump { grid-template-columns: 1fr; } .directory-hint { display: none; } .directory-toggle { margin-left: auto; } }
  .catalog-shell :global(.search-input) { background: var(--navy); }
  .catalog-shell :global(.btn-quiet) { color: var(--text-dim); }
  .group-heading { align-items: baseline; gap: 24px; }
  .group-heading h2 { max-width: 32ch; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -.025em; }
  .group-count { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .catalog-shell :global(.search-input:focus-within) { border-color: var(--gold); }
  .catalog-shell :global(.btn:active) { transform: translateY(1px); }
  @media (min-width: 768px) {
    [data-catalog-group] { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: clamp(32px, 4vw, 64px); align-items: start; }
    [data-catalog-group] > .section-head { display: grid; gap: 16px; margin: 0; }
    [data-catalog-group] h2 { font-size: clamp(20px, 2vw, 26px); text-wrap: pretty; }
    [data-catalog-group] :global(.grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) { [data-catalog-group] :global(.grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
